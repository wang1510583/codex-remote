# Codex Remote Web 配置示例。复制为 .env 后按需修改。

# ===== 监听 =====
PORT=5566
HOST=0.0.0.0

# ===== Codex =====
# codex 可执行文件路径（服务器上）
CODEX_BIN=/root/.local/bin/codex
# 可选模型覆盖；不设时跟随 Codex CLI 当前配置
# CODEX_MODEL=gpt-5.6-sol
# 可选思考强度覆盖；不设时跟随 Codex CLI 当前配置
# CODEX_REASONING_EFFORT=medium
# 工作目录根（网页端文件管理限制在此目录下；留空则用项目父目录）
CODEX_WORK_DIR=

# ===== 鉴权 =====
# 【必填】网页登录密码
CODEX_REMOTE_PASSWORD=
# 被控端配对令牌（留空则复用登录密码；建议单独设置一个不同的值）
CODEX_REMOTE_CONNECTOR_TOKEN=
# auth 密钥（留空自动随机生成；固定后 cookie 跨重启才有效）
# CODEX_REMOTE_AUTH_SECRET=

# ===== 路由 =====
# 路由前缀，用于反向代理子路径
CODEX_REMOTE_ROUTE_PREFIX=/codex-remote
# 外部基础路径（一般留空，用 routePrefix）
# CODEX_REMOTE_BASE_PATH=

# ===== 连接超时 =====
CODEX_CONNECT_WAIT_MS=5000
CODEX_CONNECT_TIMEOUT_MS=60000
# 单个 Codex 回合的最长等待时间；超时后网页端会自动中断并恢复可发送状态
CODEX_TURN_TIMEOUT_MS=1200000

# ===== Web Push（浏览器后台通知）=====
WEB_PUSH_SUBJECT=mailto:admin@example.com
# 不填则自动生成密钥并存到 data/push-vapid.json
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=

# ===== 微信通知（可选，不填则不推送微信）=====
# WECHAT_GATEWAY_URL=
# WECHAT_GATEWAY_TOKEN=
# WECHAT_TO=
# WECHAT_SOURCE=codex-remote-web

# ===== 被控端 =====
# 被控端轮询/心跳间隔（兼容旧版轮询模式）
# CODEX_REMOTE_CONNECTOR_POLL_MS=3000
# CODEX_REMOTE_CONNECTOR_HEARTBEAT_MS=180000

# ===== 纯控制中心模式 =====
# 设为 1 时，服务器不跑 codex，只作为控制中心管理被控端：
# 前端隐藏"本机"选项，必须先添加被控端并切换才能使用
# CODEX_REMOTE_DISABLE_LOCAL=0
